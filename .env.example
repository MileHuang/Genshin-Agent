# Model used by the daily planner's Moonshot-compatible API.
MOONSHOT_API_KEY=replace_with_your_moonshot_api_key
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Personal RAG embeddings. "auto" uses OpenAI when OPENAI_API_KEY is present,
# otherwise it keeps the deterministic local Hash embedding for offline use.
RAG_EMBEDDING_PROVIDER=auto
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
