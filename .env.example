# Copy this file to .env and replace the placeholder with your own key.
MOONSHOT_API_KEY=replace_with_your_moonshot_api_key
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_REASONING_EFFORT=max
KIMI_TIMEOUT_SECONDS=120

# Open-Meteo is live and requires no API key. Use mock for offline development.
WEATHER_PROVIDER=open-meteo
WEATHER_TIMEOUT_SECONDS=20

# Google Calendar reads existing events and writes confirmed plans. The OAuth JSON stays in secrets/ and is ignored by Git.
CALENDAR_PROVIDER=mock
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Asia/Shanghai
GOOGLE_CLIENT_SECRET_FILE=secrets/google_client_secret.json
GOOGLE_TOKEN_FILE=data/google_token.json
GOOGLE_SYNC_RECORD_FILE=data/google_calendar_syncs.json

# Todoist supplies open tasks to the planner. Keep the real token in .env only.
TODOIST_API_TOKEN=replace_with_your_todoist_api_token
TODOIST_API_BASE_URL=https://api.todoist.com/api/v1
TODOIST_TIMEOUT_SECONDS=20

# Optional: uncomment to replace the built-in planning prompt.
# AGENT_SYSTEM_PROMPT=You are a practical personal planning assistant.
